function Card({ children, className = "" }) {
  return <div className={`rounded-3xl border bg-white shadow-sm ${className}`}>{children}</div>;
}

function Button({ children, href, variant = "primary" }) {
  const classes =
    variant === "outline"
      ? "inline-flex items-center justify-center rounded-2xl border border-rose-200 bg-white px-6 py-3 font-semibold text-rose-700 shadow-sm transition hover:bg-rose-50"
      : "inline-flex items-center justify-center rounded-2xl bg-rose-600 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-rose-700";

  return (
    <a href={href} className={classes}>
      {children}
    </a>
  );
}

